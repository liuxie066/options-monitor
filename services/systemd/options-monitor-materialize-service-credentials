#!/usr/bin/python3
from __future__ import annotations

import argparse
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from collections.abc import Callable, Sequence
from pathlib import Path
from typing import Any


SYSTEMD_CREDS = Path("/usr/bin/systemd-creds")
FINDMNT = Path("/usr/bin/findmnt")
DEFAULT_RUNTIME_ROOT = Path("/run/options-monitor/credentials")
MAX_CREDENTIAL_BYTES = 64 * 1024
MAX_ENCRYPTED_CREDENTIAL_BYTES = 128 * 1024
_UNIT_NAME_PATTERN = re.compile(r"^options-monitor-[A-Za-z0-9_.@-]+\.service$")
_CREDENTIAL_ID_PATTERN = re.compile(r"^om-[a-z0-9]+(?:-[a-z0-9]+)*$")


class MaterializerError(RuntimeError):
    pass


def validate_unit_name(unit_name: str) -> str:
    value = str(unit_name or "").strip()
    if not _UNIT_NAME_PATTERN.fullmatch(value):
        raise MaterializerError("unsupported options-monitor unit name")
    return value


def _credential_ids(values: Sequence[str]) -> tuple[str, ...]:
    normalized = tuple(str(value or "").strip() for value in values)
    if not normalized or any(not value for value in normalized):
        raise MaterializerError("at least one credential id is required")
    if len(set(normalized)) != len(normalized):
        raise MaterializerError("duplicate credential id")
    if any(not _CREDENTIAL_ID_PATTERN.fullmatch(value) for value in normalized):
        raise MaterializerError("unsupported credential id")
    return normalized


def _require_absolute(path: Path, *, label: str) -> Path:
    if not path.is_absolute():
        raise MaterializerError(f"{label} must be an absolute path")
    if ".." in path.parts:
        raise MaterializerError(f"{label} must not contain parent traversal")
    return path


def _secure_directory_chain(
    path: Path,
    *,
    required_owner_uid: int,
    label: str,
) -> None:
    """Reject replaceable or symlinked ancestors before opening root-owned secrets."""
    current = Path(path.anchor)
    for part in path.parts[1:]:
        current /= part
        try:
            metadata = current.lstat()
        except OSError as exc:
            raise MaterializerError(f"{label} is unavailable") from exc
        if not stat.S_ISDIR(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
            raise MaterializerError(f"{label} must not contain symbolic links")
        if metadata.st_uid not in {0, required_owner_uid}:
            raise MaterializerError(f"{label} has an unsafe ancestor owner")
        untrusted_write = stat.S_IMODE(metadata.st_mode) & 0o022
        sticky_root_directory = (
            metadata.st_uid == 0 and bool(metadata.st_mode & stat.S_ISVTX)
        )
        if untrusted_write and not sticky_root_directory:
            raise MaterializerError(f"{label} has a replaceable ancestor")


def _secure_directory(
    path: Path,
    *,
    required_owner_uid: int,
    writable_mask: int,
    label: str,
) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise MaterializerError(f"{label} is unavailable") from exc
    if not stat.S_ISDIR(metadata.st_mode) or path.is_symlink():
        raise MaterializerError(f"{label} must be a real directory")
    if metadata.st_uid != required_owner_uid:
        raise MaterializerError(f"{label} has an unsafe owner")
    if stat.S_IMODE(metadata.st_mode) & writable_mask:
        raise MaterializerError(f"{label} is writable by an untrusted identity")
    return metadata


def _secure_encrypted_source(path: Path, *, required_owner_uid: int) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise MaterializerError("encrypted credential source is unavailable") from exc
    if not stat.S_ISREG(metadata.st_mode) or path.is_symlink():
        raise MaterializerError("encrypted credential source must be a regular file")
    if metadata.st_uid != required_owner_uid:
        raise MaterializerError("encrypted credential source has an unsafe owner")
    if stat.S_IMODE(metadata.st_mode) & 0o077:
        raise MaterializerError("encrypted credential source permissions are too broad")
    if metadata.st_size <= 0:
        raise MaterializerError("encrypted credential source is empty")
    if metadata.st_size > MAX_ENCRYPTED_CREDENTIAL_BYTES:
        raise MaterializerError("encrypted credential source is unexpectedly large")


def verify_runtime_filesystem(runtime_root: Path) -> None:
    if runtime_root != DEFAULT_RUNTIME_ROOT:
        raise MaterializerError("runtime credential root is not the compiled safe path")
    try:
        result = subprocess.run(
            [
                str(FINDMNT),
                "--noheadings",
                "--output",
                "FSTYPE",
                "--target",
                "/run",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=10,
            check=False,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"},
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise MaterializerError("cannot verify runtime credential filesystem") from exc
    if result.returncode != 0 or result.stdout.strip() != "tmpfs":
        raise MaterializerError("runtime credential root must be backed by tmpfs")


def _ensure_runtime_root(
    runtime_root: Path,
    *,
    owner_uid: int,
    owner_gid: int,
) -> None:
    _require_absolute(runtime_root, label="runtime credential root")
    try:
        runtime_root.parent.mkdir(parents=True, mode=0o755, exist_ok=True)
    except OSError as exc:
        raise MaterializerError("cannot create runtime credential parent") from exc
    _secure_directory(
        runtime_root.parent,
        required_owner_uid=owner_uid,
        writable_mask=0o022,
        label="runtime credential parent",
    )
    try:
        os.chown(runtime_root.parent, owner_uid, owner_gid)
        os.chmod(runtime_root.parent, 0o711)
    except OSError as exc:
        raise MaterializerError("cannot secure runtime credential parent") from exc
    try:
        runtime_root.mkdir(mode=0o755, exist_ok=True)
    except OSError as exc:
        raise MaterializerError("cannot create runtime credential root") from exc
    _secure_directory(
        runtime_root,
        required_owner_uid=owner_uid,
        writable_mask=0o022,
        label="runtime credential root",
    )
    try:
        os.chown(runtime_root, owner_uid, owner_gid)
        os.chmod(runtime_root, 0o755)
    except OSError as exc:
        raise MaterializerError("cannot secure runtime credential root") from exc


def _decrypt_with_systemd_creds(
    credential_id: str,
    encrypted_path: Path,
    output_path: Path,
) -> None:
    try:
        result = subprocess.run(
            [
                str(SYSTEMD_CREDS),
                "decrypt",
                f"--name={credential_id}",
                str(encrypted_path),
                str(output_path),
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
            check=False,
            close_fds=True,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"},
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise MaterializerError(f"credential decrypt failed: {credential_id}") from exc
    if result.returncode != 0:
        raise MaterializerError(f"credential decrypt failed: {credential_id}")


def _secure_plaintext_output(
    path: Path,
    *,
    required_owner_uid: int,
    credential_owner_uid: int,
    credential_owner_gid: int,
) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise MaterializerError("decrypted credential output is unavailable") from exc
    if not stat.S_ISREG(metadata.st_mode) or path.is_symlink():
        raise MaterializerError("decrypted credential output must be a regular file")
    if metadata.st_uid != required_owner_uid:
        raise MaterializerError("decrypted credential output has an unsafe owner")
    if metadata.st_size <= 0 or metadata.st_size > MAX_CREDENTIAL_BYTES:
        raise MaterializerError("decrypted credential output has an invalid size")
    try:
        os.chown(path, credential_owner_uid, credential_owner_gid)
        os.chmod(path, 0o400)
    except OSError as exc:
        raise MaterializerError("cannot secure decrypted credential output") from exc


def _remove_stage(stage: Path) -> None:
    try:
        stage.chmod(0o700)
        shutil.rmtree(stage)
    except FileNotFoundError:
        return
    except OSError as exc:
        raise MaterializerError("cannot remove staged runtime credentials") from exc


def cleanup_credentials(
    *,
    unit_name: str,
    credential_ids: Sequence[str],
    runtime_root: Path,
    required_owner_uid: int = 0,
) -> dict[str, Any]:
    unit = validate_unit_name(unit_name)
    _credential_ids(credential_ids)
    root = _require_absolute(Path(runtime_root), label="runtime credential root")
    target = root / unit
    try:
        metadata = target.lstat()
    except FileNotFoundError:
        return {
            "action": "cleanup",
            "unit": unit,
            "removed": False,
            "values_exposed": False,
        }
    except OSError as exc:
        raise MaterializerError("runtime credential directory is unavailable") from exc
    if not stat.S_ISDIR(metadata.st_mode) or target.is_symlink():
        raise MaterializerError("runtime credential target must be a real directory")
    if metadata.st_uid != required_owner_uid or stat.S_IMODE(metadata.st_mode) & 0o022:
        raise MaterializerError("runtime credential target has unsafe ownership or permissions")
    try:
        entries = tuple(target.iterdir())
    except OSError as exc:
        raise MaterializerError("cannot inspect runtime credential directory") from exc
    for entry in entries:
        try:
            entry_metadata = entry.lstat()
        except OSError as exc:
            raise MaterializerError("cannot inspect runtime credential entry") from exc
        if (
            not _CREDENTIAL_ID_PATTERN.fullmatch(entry.name)
            or not stat.S_ISREG(entry_metadata.st_mode)
            or entry.is_symlink()
        ):
            raise MaterializerError("unexpected runtime credential entry")
    try:
        target.chmod(0o700)
        for entry in entries:
            entry.unlink()
        target.rmdir()
    except OSError as exc:
        raise MaterializerError("cannot clean runtime credential directory") from exc
    return {
        "action": "cleanup",
        "unit": unit,
        "removed": True,
        "values_exposed": False,
    }


def materialize_credentials(
    *,
    unit_name: str,
    credential_ids: Sequence[str],
    store_root: Path,
    runtime_root: Path,
    owner_uid: int,
    owner_gid: int,
    credential_owner_uid: int | None = None,
    credential_owner_gid: int | None = None,
    required_source_uid: int = 0,
    runtime_root_gid: int | None = None,
    verify_runtime_filesystem: Callable[[Path], None] = verify_runtime_filesystem,
    decrypt_credential: Callable[[str, Path, Path], None] = _decrypt_with_systemd_creds,
) -> dict[str, Any]:
    unit = validate_unit_name(unit_name)
    names = _credential_ids(credential_ids)
    store = _require_absolute(Path(store_root), label="encrypted credential store")
    runtime = _require_absolute(Path(runtime_root), label="runtime credential root")
    verify_runtime_filesystem(runtime)
    _secure_directory_chain(
        store,
        required_owner_uid=required_source_uid,
        label="encrypted credential store",
    )
    _secure_directory(
        store,
        required_owner_uid=required_source_uid,
        writable_mask=0o022,
        label="encrypted credential store",
    )
    sources: dict[str, Path] = {}
    for credential_id in names:
        source = store / credential_id
        _secure_encrypted_source(source, required_owner_uid=required_source_uid)
        sources[credential_id] = source
    _ensure_runtime_root(
        runtime,
        owner_uid=owner_uid,
        owner_gid=owner_gid if runtime_root_gid is None else runtime_root_gid,
    )

    old_umask = os.umask(0o077)
    stage: Path | None = None
    try:
        stage = Path(tempfile.mkdtemp(prefix=f".{unit}.", dir=runtime))
        os.chown(stage, owner_uid, owner_gid)
        os.chmod(stage, 0o700)
        for credential_id in names:
            output = stage / credential_id
            decrypt_credential(credential_id, sources[credential_id], output)
            _secure_plaintext_output(
                output,
                required_owner_uid=owner_uid,
                credential_owner_uid=(
                    owner_uid
                    if credential_owner_uid is None
                    else credential_owner_uid
                ),
                credential_owner_gid=(
                    owner_gid
                    if credential_owner_gid is None
                    else credential_owner_gid
                ),
            )
        os.chown(stage, owner_uid, owner_gid)
        os.chmod(stage, 0o510)
        cleanup_credentials(
            unit_name=unit,
            credential_ids=names,
            runtime_root=runtime,
            required_owner_uid=owner_uid,
        )
        target = runtime / unit
        os.replace(stage, target)
        stage = None
    except MaterializerError:
        raise
    except OSError as exc:
        raise MaterializerError("cannot publish runtime credentials") from exc
    finally:
        os.umask(old_umask)
        if stage is not None:
            _remove_stage(stage)
    return {
        "action": "materialize",
        "unit": unit,
        "credential_count": len(names),
        "values_exposed": False,
    }


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Materialize allowlisted options-monitor credentials into tmpfs without printing values"
    )
    commands = parser.add_subparsers(dest="action", required=True)
    materialize = commands.add_parser("materialize")
    materialize.add_argument("--unit", required=True)
    materialize.add_argument("--deploy-user", required=True)
    materialize.add_argument("--store-root", required=True)
    materialize.add_argument("--credential-id", action="append", required=True)
    cleanup = commands.add_parser("cleanup")
    cleanup.add_argument("--unit", required=True)
    cleanup.add_argument("--credential-id", action="append", required=True)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    try:
        if os.geteuid() != 0:
            raise MaterializerError("runtime credential materialization requires root authority")
        args = _parser().parse_args(argv)
        if args.action == "materialize":
            try:
                deploy_user = pwd.getpwnam(str(args.deploy_user))
            except KeyError as exc:
                raise MaterializerError("deploy user is unavailable") from exc
            payload = materialize_credentials(
                unit_name=args.unit,
                credential_ids=tuple(args.credential_id),
                store_root=Path(args.store_root),
                runtime_root=DEFAULT_RUNTIME_ROOT,
                owner_uid=0,
                owner_gid=deploy_user.pw_gid,
                credential_owner_uid=deploy_user.pw_uid,
                credential_owner_gid=0,
                required_source_uid=0,
                runtime_root_gid=0,
            )
        else:
            payload = cleanup_credentials(
                unit_name=args.unit,
                credential_ids=tuple(args.credential_id),
                runtime_root=DEFAULT_RUNTIME_ROOT,
                required_owner_uid=0,
            )
    except MaterializerError as exc:
        print(f"credential_materializer_error={exc}", file=sys.stderr)
        return 78
    except Exception as exc:
        print(f"credential_materializer_error=internal:{type(exc).__name__}", file=sys.stderr)
        return 1
    print(json.dumps(payload, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
