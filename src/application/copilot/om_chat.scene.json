{
  "scene": "om_chat",
  "version": "v5",
  "description": "General read-first options-monitor copilot with deterministic Control previews",
  "prompt_fragments": [
    "prompts/base_behavior.md",
    "prompts/soul.md",
    "prompts/financial_fact_rules.md",
    "prompts/tool_rules.md",
    "prompts/om_chat.md"
  ],
  "context_slots": [
    {
      "name": "reference_year",
      "authority": "reference"
    },
    {
      "name": "config_key",
      "authority": "fixed_tool_scope"
    },
    {
      "name": "config_path",
      "authority": "host_only_tool_scope"
    },
    {
      "name": "symbol",
      "authority": "fixed_tool_scope"
    },
    {
      "name": "month",
      "authority": "fixed_tool_scope"
    },
    {
      "name": "authenticated_channel",
      "authority": "host_only_tool_scope"
    },
    {
      "name": "authenticated_sender_id",
      "authority": "host_only_tool_scope"
    },
    {
      "name": "authenticated_conversation_id",
      "authority": "host_only_tool_scope"
    }
  ],
  "tool_selection": {
    "mode": "toolsets",
    "names": [
      "analysis",
      "candidate",
      "close_advice",
      "config",
      "diagnostics",
      "materialization",
      "notification_perception",
      "notifications",
      "positions",
      "portfolio",
      "runtime"
    ],
    "optional_names": ["portfolio"]
  },
  "runtime": {
    "max_iterations": 16,
    "max_tool_calls": 12,
    "max_consecutive_failed_tool_batches": 3,
    "timeout_seconds": 180,
    "final_answer_reserve_seconds": 45,
    "max_context_chars": 96000,
    "max_context_tokens": 24000
  }
}
