{
  "scene": "om_chat",
  "version": "v7",
  "description": "Read-only strategy, failure and candidate explanations",
  "prompt_fragments": [
    "prompts/base_behavior.md",
    "prompts/tool_rules.md"
  ],
  "context_slots": [
    {
      "name": "reference_year",
      "authority": "reference"
    },
    {
      "name": "operating_date",
      "authority": "reference"
    },
    {
      "name": "report_now_ms",
      "authority": "host_only_tool_scope"
    },
    {
      "name": "config_key",
      "authority": "fixed_tool_scope"
    },
    {
      "name": "config_path",
      "authority": "host_only_tool_scope"
    },
    {
      "name": "symbol",
      "authority": "fixed_tool_scope"
    },
    {
      "name": "month",
      "authority": "fixed_tool_scope"
    },
    {
      "name": "authenticated_channel",
      "authority": "host_only_tool_scope"
    },
    {
      "name": "authenticated_sender_id",
      "authority": "host_only_tool_scope"
    },
    {
      "name": "authenticated_conversation_id",
      "authority": "host_only_tool_scope"
    }
  ],
  "tool_selection": {
    "mode": "tools",
    "names": [
      "project_context",
      "project_files",
      "candidate_filter_explain",
      "runtime_runs",
      "runtime_logs",
      "runtime_status",
      "receipt_read"
    ]
  },
  "runtime": {
    "max_iterations": 16,
    "max_tool_calls": 12,
    "max_consecutive_failed_tool_batches": 3,
    "timeout_seconds": 180,
    "final_answer_reserve_seconds": 45
  }
}
