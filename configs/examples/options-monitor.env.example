# Copy to /etc/options-monitor/options-monitor.env on Linux.
# Fill real values on the server only. Do not commit real secrets.

OM_FEISHU_APP_ID=""
OM_FEISHU_APP_SECRET=""
OM_FEISHU_HOLDINGS_TABLE=""

# Unified Feishu bot channel for inbound messages, replies, and notifications.
OM_FEISHU_BOT_APP_ID=""
OM_FEISHU_BOT_APP_SECRET=""
OM_FEISHU_BOT_USER_OPEN_ID="ou_xxx"
OM_FEISHU_BOT_ALLOWED_OPEN_IDS="ou_xxx"
OM_INBOUND_AUDIT_DB="/var/lib/options-monitor/output_shared/state/inbound_control.sqlite3"

# Independent read-only token for GET /quality/status. Do not reuse the Hub,
# PM, Feishu, or broker credential.
OM_QUALITY_READ_TOKEN=""
OM_QUALITY_INSTANCE_ID="options-monitor-prod"

# Set only after the producer is deployed, a production read-only baseline has
# been reviewed, and the Hub component is explicitly onboarded. When enabled,
# dependent consumers fail closed on stale or blocking OM quality evidence.
OM_QUALITY_ONBOARDED="false"

# Assistant LLM provider API keys. Configure only the provider you use.
OM_LLM_API_KEY=""
DEEPSEEK_API_KEY=""
MOONSHOT_API_KEY=""
KIMI_API_KEY=""
