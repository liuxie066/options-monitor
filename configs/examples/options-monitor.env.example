# Ordinary non-secret process settings only. Runtime secrets default to macOS
# Keychain or per-unit systemd credentials; see docs/SECRET_STORAGE.md.
OM_SECRET_BACKEND="auto"

OM_FEISHU_APP_ID=""
OM_FEISHU_HOLDINGS_TABLE=""

# Unified Feishu bot channel for inbound messages, replies, and notifications.
OM_FEISHU_BOT_APP_ID=""
OM_FEISHU_BOT_USER_OPEN_ID="ou_xxx"
OM_FEISHU_BOT_ALLOWED_OPEN_IDS="ou_xxx"
OM_INBOUND_AUDIT_DB="/var/lib/options-monitor/output_shared/state/inbound_control.sqlite3"

# Producer identity recorded in local quality artifacts.
OM_QUALITY_INSTANCE_ID="options-monitor-prod"

# Set only after the producer is deployed, a production read-only baseline has
# been reviewed, and local consumer integration is verified. When enabled,
# dependent consumers fail closed on stale or blocking OM quality evidence.
OM_QUALITY_ONBOARDED="false"

# Temporary compatibility only. Uncomment OM_SECRET_BACKEND=env and only the
# required names in controlled CI/test/migration environments. Secure backends
# never fall back to these values automatically.
# OM_SECRET_BACKEND="env"
# OM_FEISHU_APP_SECRET=""
# OM_FEISHU_BOT_APP_SECRET=""
# OM_INBOUND_OPERATION_HMAC_KEY=""
# OM_LLM_API_KEY=""
# DEEPSEEK_API_KEY=""
# MOONSHOT_API_KEY=""
# KIMI_API_KEY=""
