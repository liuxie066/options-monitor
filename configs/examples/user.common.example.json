{
  "watchdog": {
    "retry_enabled": true,
    "retry_interval_sec": 3,
    "retry_timeout_sec": 25,
    "success_threshold": 2
  },
  "alert_policy": {
    "change_annual_threshold": 0.02,
    "sell_put": {
      "high_annual": 0.2,
      "high_spread_max": 0.2,
      "medium_annual": 0.12
    },
    "sell_call": {
      "high_annual": 0.1,
      "high_total": 0.15,
      "medium_annual": 0.06
    }
  },
  "notifications": {
    "provider": "wechat_clawbot",
    "channel": "wechat_clawbot",
    "target": "wechat:ops",
    "daily_brief": {
      "max_total_items": 40,
      "max_close_items": 5,
      "max_roll_up_items": 5,
      "max_roll_down_items": 5,
      "max_candidates_per_strategy": 3,
      "max_rejection_reasons": 5
    },
    "enabled": false
  }
}
