accounts:
  lx:
    type: futu
    futu_account_id: "REPLACE_WITH_FUTU_ACCOUNT_ID"
  sy:
    type: external_holdings
    holdings_account: sy

templates:
  put_base:
    sell_put:
      min_annualized_net_return: 0.10
      min_net_income: 50.0

markets:
  us:
    accounts: [lx, sy]
    symbols:
      - NVDA
      - FUTU
      - GOOGL
    overrides:
      FUTU:
        sell_put:
          dte: [20, 45]
          strike: [55, 85]
        covered_call:
          enabled: true
          dte: [20, 60]
          strike: [90, 120]
        combo_yield: true

  hk:
    accounts: [lx]
    symbols:
      - "0700.HK"
      - "9992.HK"

assistant:
  enabled: true
  context_window_messages: 8
  planner:
    enabled: true
  active_model: deepseek-default
  models:
    deepseek-default:
      provider: deepseek
      base_url: "https://api.deepseek.com"
      model: deepseek-chat
      api_key_env: DEEPSEEK_API_KEY
      confidence_min: 0.75
      timeout_seconds: 20
      max_output_tokens: 512
    openai-default:
      provider: openai
      base_url: ""
      model: gpt-5.2
      api_key_env: OM_LLM_API_KEY
      confidence_min: 0.75
      timeout_seconds: 20
      max_output_tokens: 512

inbound:
  feishu_ws:
    ack_reaction: THUMBSUP
