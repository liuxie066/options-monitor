        "aa7e8ca74c3f6df19754eacd30d75af8554e0cfc",
        "50a1719dfc48b67f54e0508c2906c69c6c297f9e"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Rejected new Wheel Call intents when Wheel is disabled for the account instead of allowing a stale candidate snapshot to reserve share coverage.",
