  "release_notes": [
    {
      "category": "New Features",
      "text": "支持按时间窗流式读取历史通知审计，并提供事故磁盘回收的只读引用检查预览。",
      "commits": [
        "c15d14a957f2043021ebfda7a75426f7dba92ad5"
      ]
    },
    {
      "category": "Improvements",
      "text": "Close Advice 改用净兑现至少 80% 与剩余最高年化不超过 10% 的提前平仓条件，并展示资金分母和决策指标。",
      "commits": [
        "759dce0bcefda0de36273970bcf9e090eca7a604"
      ]
    },
    {
      "category": "Improvements",
      "text": "审计文件写入侧轮转，服务日志、drift 明细与无凭证健康检查提供更清晰的运维证据。",
      "commits": [
        "c15d14a957f2043021ebfda7a75426f7dba92ad5"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "修复已知标的行情失败时 Close Advice 将逐仓数据缺口误判为封存快照整体失效的问题。",
      "commits": [
        "0af1b6a0a4548ed4741635c6381d2d711baa26fb",
        "770de5a8207dfa0415e206239c362759872f344b"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "OpenD 登录失效、验证码和执行失败时，计划 Tick 当轮有界失败并留下可查询的原因、阶段、运行状态和告警证据。",
      "commits": [
        "c15d14a957f2043021ebfda7a75426f7dba92ad5"
      ]
    }
