  "release_notes": [
    {
      "category": "Breaking Changes",
      "text": "Reject the retired `runtime.pipeline_symbol_max_workers` and `runtime.watchlist_max_workers` settings instead of silently ignoring them.",
      "commits": [
        "50bd4c33ff2e28a77e875f14e369e65e36521151",
        "b886dba0e360fc607d677992bc62ae1fb9c4457a"
      ]
    },
    {
      "category": "Improvements",
      "text": "Reduced batch manual-adjustment preflight to one current projection and one combined candidate projection, bounding full-history reads without changing atomic validation.",
      "commits": [
        "e577685976efea16789ca72d8ab1b30f4cd31a03",
        "7ddd7309a9922a81bf224f4aedf4a1556162568a"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Allowed audited metadata-only binding of missing Futu account and order identities on historical open events, preserving event identity and downstream close/adjust lineage for subsequent fee enrichment.",
      "commits": [
        "f575b22ed902c4a03408efc0695d811560356a67",
        "1cea914066bf969102e9fb784506bb73b755f4df"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Bound Strategy Lab FX observation time to the sealed prepared-receipt timestamp instead of the earlier position snapshot, preserving strict temporal validation for natural formal points.",
      "commits": [
        "c800907e92ac31580320ac17e8132a36d7b78968",
        "fb4680e8138ac5154341bf51689f041aed3a6974"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Added an audited OpenD-evidence repair for incorrect historical Futu trade times, preserving event identity and projection lineage while invalidating stale event-time cash conversions for explicit backfill.",
      "commits": [
        "b61dd8166b164a4dad35d3699ce2cd45a3512d14",
        "d25bf8b5c7ddd1c55aaf270b90b84acf74f654a9"
      ]
    }
  ],
