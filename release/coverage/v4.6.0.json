        "59ea3554136dcdde5dc584a59029651cf3e26730",
        "457f6eb574f9e3eebbfc619b3d50c14c104a61bc",
        "75593d6f24f7e89b87908cdfac9683832f754606"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "通知历史分页在下一偏移超出上限时停止签发不可用游标，保留当前页、真实 has_more 和 partial 原因，提示缩小查询范围（#849）。",
      "commits": [
        "0857687029f41d03cd9f89a90d9c94f4b1d4919b",
        "041babc82f4cd0b616c7fbd18e1f2917d4d4e7b3",
        "eb417921d993ae3e340298a9f8479c1bec6c810e",
        "24f386064710dfec1f18504091cbbcbbaad02716"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "启用策略的 DTE 窗口复用共享数值校验，修复数字字符串按字典序误拒和混合类型异常，保留必填、非法输入拒绝及原始配置类型（#850）。",
      "commits": [
        "f808f2f4a5853e72b34b8eda3eb740fea6d5a7db",
        "3ed35956c98b7fb5507b6fbef713b5d9c2f2bbc5",
        "e613e266dd035f24f537760d31e4a01cfdd8262e",
        "e6056f55676d36442e13bd5417a7292ec1fde04a"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "生命周期发现忽略已被替代的历史 case，保留真实冲突；本地操作结果读取实际嵌套决策状态，避免误报 not_due；结算等待规则不变（#857）。",
      "commits": [
        "2036b10e5558fc644c1b3bcd01231b9ba41324e8",
        "bfe55ae849d99231bf1ecfbd10e1b7c478924094",
        "1881327ba222bbc95b78c981f2a83df2ba24197e",
        "a2d19acd85f30676c63ce646dce4c05c4dfb987c"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Bot 在线就绪检查与写连接采用一致打开方式，查询仍设为只读并及时关闭，避免 macOS SQLite 混合连接锁模式触发 I/O 错误；离线迁移保持只读打开（#857）。",
      "commits": [
        "2036b10e5558fc644c1b3bcd01231b9ba41324e8",
        "bfe55ae849d99231bf1ecfbd10e1b7c478924094",
        "1881327ba222bbc95b78c981f2a83df2ba24197e",
        "a2d19acd85f30676c63ce646dce4c05c4dfb987c"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "手工交易草稿的整数标签改为无损解析，小数输入在生成预览前明确报错，保留 `1`、`1.0` 等合法整数表示，避免张数和交割股数被静默截断（#747、#854）。",
      "commits": [
        "b56983ce861353fec96b6505918dca05bb1c552a"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "结算观察在转换前无损校验相关股票交割股数，拒绝小数等无效数量并保留合法整数兼容，避免截断后生成错误的整手交割事实（#743、#853）。",
      "commits": [
        "8ab0e532f33da0c4cf8265727bd8d42321d20340"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "YAML 配置构建统一标的别名与覆盖项的规范身份，拒绝大小写或别名冲突，编辑既有标的时保留源键，避免别名落入运行快照或策略被静默覆盖（#754、#755、#852）。",
      "commits": [
        "9333241006b6a0231750509ffeb86432c0d88364"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "配置构建提前拒绝定时扫描无法读取的开盘后、收盘前偏移表示，保留合法整数及数值整型输入，避免构建成功后调度失败（#752、#855）。",
      "commits": [
        "6385f68c4f498aed1169bfdf592d079b518b4778"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "成交接入按账户在同一事务内认领 PM 刷新意图，组内失败回滚并在每组提交后立即派发，避免后续认领失败吞掉前组提示；提交后硬中断的发送不确定窗口仍保留，历史标记不自动重置（#858、#803）。",
      "commits": [
        "1aa02239bfdd2696d0f1f62a261823728276c8db",
        "9f923dc62e290d1a388327c339cff1f9a86f588a"
      ]
    }
  ],
