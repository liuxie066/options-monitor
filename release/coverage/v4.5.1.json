        "ab33a13179c0ef3b24813c4642528a0c8cfe91ff",
        "799e8b094d2d54ca27ff317cb7a646b428d614bf"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "公共持仓查询对事件及持仓载荷中的非对象 JSON 明确报错，避免把损坏记录当作完整空结果（#823）。",
      "commits": [
        "eb8ed7a1fa3d4a6303c418f3084bcd41ef2e7e6e",
