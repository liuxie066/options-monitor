  "release_notes": [
    {
      "category": "Bug Fixes",
      "text": "普通 CSP/CC 扫描封存实际决策时间，离线指标复算消费同一时刻并拒绝缺失、无效或冲突时间；保留旧快照读取，不回填历史时间、不改变筛选排序和张数（#832）。",
      "commits": [
        "bfe4fa239278f3bc17c0e9de0b2796aae2acbdeb",
        "03743dd4fcb9db96631da76b593158af9575d857",
        "3128367261f39601050d4e381b2e19de1ec993b2",
