  "release_notes": [
    {
      "category": "Breaking Changes",
      "text": "Removed the generic `analysis_catalog` and `analysis_query` tools from Tool Gateway and Copilot; current reads use canonical typed tools, while unsupported cross-view aggregation remains unavailable.",
      "commits": [
        "32bc15b4cf1649c7f62b83de5efc442ac8df3426",
        "93bee485b8fc8359a6b1ba434d4ee3ab44939547"
      ]
    },
    {
      "category": "New Features",
      "text": "Added an audited CNY aggregate for option net cash flow, summing validated event-time conversions while keeping native-currency metrics available when CNY evidence is incomplete.",
      "commits": [
        "4716bf127b5cb3da657bd420053ca25709a079b3",
        "7d5052269abcbcb8a300f4fec6fac1e3c874ea6e"
      ]
    },
    {
      "category": "Improvements",
      "text": "Reduced required-data CSV projection validation overhead by building each canonical row once while preserving fail-closed schema and enrichment semantics.",
      "commits": [
        "b911eea619b27974246c42caecc8bc1e472a44ef",
        "79db01435328df890264131317c8b26de229e17e"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Queried and persisted actual option fees by the specific broker order after automatic trade intake, with exact account isolation, terminal-order evidence, and recent-history retry instead of a full-ledger fee scan.",
      "commits": [
        "d052d7b5753559935bd51d9fac94109c887634ef",
        "214181f129354cf970bf5fee10598efc0605f9cc"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Scoped Strategy Lab formal-point positions, marks, and position-derived FX to the point market, rejecting unknown or cross-market evidence.",
      "commits": [
        "15e826bb215aeae95ce7a178ef0c7ad052f0a340",
        "f3cd50c883f085a62d196942a7ddfad0270010b2"
      ]
    }
  ],
