  "release_notes": [
    {
      "category": "Improvements",
      "text": "Added explicit Bot task completion handling and independent read rules for bounded, auditable operations.",
      "commits": [
        "1e27571e7341eda7d682a9249fa490ae9c933083"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Scoped YAML freshness checks to the effective market input, preventing an unrelated market's configuration from making runtime state appear fresh.",
      "commits": [
        "98953aa6bbfac9058c17a1caa0b20990850d03b6"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Bound Bot configuration identity to its authorized market and read scheduler history from the production state location, distinguishing missing or invalid data from empty history.",
      "commits": [
        "7f91b905519dabae1e4c59634c676e0dc6505e9c"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Added an authorized OM scheduled-task inventory with structured names, counts, and independent enabled/active states; preserved explicit query failures and successful memory receipts in the final response.",
      "commits": [
        "7f91b905519dabae1e4c59634c676e0dc6505e9c"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Preserved candidate provenance and answer evidence through Bot tool responses so reports retain their source facts.",
      "commits": [
        "684ddeb299abbad80b83e7c416ef7ff50c1afa47",
        "acb8caedd47e7e39e1b7a1354f6f2c89017207da"
      ]
    },
    {
      "category": "Bug Fixes",
      "text": "Made CSP/CC activation a single durable operation and kept cleanly closed activation ledgers readable while rejecting partial WAL sidecars.",
      "commits": [
        "231ebf9ed65f842563f22d05622dd0375039e1c8",
        "0d7979043eeaaf90aae3c62d80960f1d8db09a2a"
      ]
    }
  ],
